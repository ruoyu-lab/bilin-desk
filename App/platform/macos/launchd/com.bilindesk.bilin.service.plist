<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 后台服务（LaunchDaemon，root）：开机就运行，退出了 launchd 再启动（rc/system_service.h） -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bilindesk.bilin.service</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Bilin.app/Contents/Helpers/BilinService</string>
        <string>--daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
